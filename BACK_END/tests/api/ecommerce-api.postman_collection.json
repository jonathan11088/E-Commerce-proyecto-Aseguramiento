                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 201\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json().order;",
                  "const price = Number(pm.collectionVariables.get(\"productPrice\"));",
                  "pm.test(\"Esquema del pedido creado\", () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: \"object\", required: [\"message\", \"order\"],",
                  "        properties: { order: { type: \"object\", required: [\"id\", \"totalAmount\", \"paymentMethod\", \"items\"],",
                  "            properties: { items: { type: \"array\", minItems: 1, items: { type: \"object\", required: [\"quantity\", \"priceAtPurchase\", \"product\"] } } } } }",
                  "    });",
                  "});",
                  "pm.test(\"Congela el precio y calcula el total (RF-19)\", () => {",
                  "    pm.expect(order.paymentMethod).to.eql(\"Credit Card\");",
                  "    pm.expect(order.items[0].priceAtPurchase).to.eql(price);",
                  "    pm.expect(order.totalAmount).to.be.closeTo(price * 3, 0.01);",
                  "});",
                  "pm.test(\"Descuenta 3 unidades del stock\", () => {",
                  "    pm.expect(order.items[0].product.stock).to.eql(Number(pm.collectionVariables.get(\"stockBefore\")) - 3);",
                  "});",
                  "pm.test(\"No expone el hash del cliente (DEF-11)\", () => pm.expect(order.user).to.not.have.property(\"passwordHash\"));",
                  "pm.collectionVariables.set(\"orderId\", order.id);"
                ]
