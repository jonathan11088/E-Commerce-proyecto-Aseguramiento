        {
          "name": "Filtrar por rango de precio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos los productos estan entre 100 y 500 (RF-10)\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.products.length).to.be.above(0);",
                  "    body.products.forEach(p => pm.expect(p.price).to.be.within(100, 500));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
