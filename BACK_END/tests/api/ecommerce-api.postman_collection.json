    {
      "name": "02 Autenticacion",
      "description": "Registro e inicio de sesion. RF-01 a RF-04 y RNF-03.",
      "item": [
        {
          "name": "Registrar cliente nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo unico en cada ejecucion para que la coleccion se pueda repetir",
                  "pm.collectionVariables.set(\"customerEmail\", `ana.${Date.now()}@mail.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Crea la cuenta como customer sin exponer el hash (RF-01)\", () => {",
                  "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get(\"customerEmail\"));",
                  "    pm.expect(body.user.role).to.eql(\"customer\");",
                  "    pm.expect(body.user.isLocked).to.eql(false);",
                  "    pm.expect(body.user).to.not.have.property(\"passwordHash\");",
                  "});",
                  "pm.collectionVariables.set(\"customerId\", body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          }
        },
