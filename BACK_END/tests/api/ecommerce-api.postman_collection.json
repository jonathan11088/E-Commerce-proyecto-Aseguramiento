              "query": [
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "maxPrice",
                  "value": "500"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Arbol de taxonomia",
          "event": [
