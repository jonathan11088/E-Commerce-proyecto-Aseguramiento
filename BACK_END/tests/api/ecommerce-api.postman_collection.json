              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estructura Tipo > Categoria > Subcategoria (RF-09)\", () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: \"object\", required: [\"taxonomy\"],",
                  "        properties: { taxonomy: { type: \"array\", minItems: 1, items: {",
                  "            type: \"object\", required: [\"id\", \"name\", \"categories\"],",
                  "            properties: { categories: { type: \"array\", items: { type: \"object\", required: [\"id\", \"name\", \"subCategories\"] } } } } } }",
                  "    });",
                  "});"
