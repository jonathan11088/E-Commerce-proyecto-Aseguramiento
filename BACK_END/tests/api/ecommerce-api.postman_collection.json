        {
          "name": "Detalle de producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve el producto pedido con su ruta de taxonomia (RF-13)\", () => {",
                  "    const body = pm.response.json();",
                  "    const product = body.product || body;",
                  "    pm.expect(product.id).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
                  "    pm.expect(product.subCategory.category.type.name).to.be.a(\"string\");",
                  "});"
