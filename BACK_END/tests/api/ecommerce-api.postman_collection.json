{
  "info": {
    "name": "E-Commerce - Pruebas de API (E11)",
    "description": "Pruebas de API del proyecto E-Commerce. Cada solicitud verifica codigo de respuesta y contenido; varias validan el esquema JSON. Las carpetas se ejecutan en orden y la carpeta 03 encadena el flujo completo de compra. Se ejecuta en el pipeline con Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Catalogo (invitado)",
      "description": "Consultas publicas del catalogo. RF-09 a RF-13 y RNF-04.",
      "item": [
        {
          "name": "Salud del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El servicio responde Ok con fecha\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"Ok\");",
                  "    pm.expect(new Date(body.timeStamp).toString()).to.not.eql(\"Invalid Date\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Listar productos paginados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Esquema de listado con paginacion\", () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: \"object\",",
                  "        required: [\"products\", \"pagination\"],",
                  "        properties: {",
                  "            products: { type: \"array\", items: { type: \"object\", required: [\"id\", \"name\", \"price\", \"stock\"],",
                  "                properties: { id: { type: \"number\" }, name: { type: \"string\" }, price: { type: \"number\" }, stock: { type: \"number\" } } } },",
                  "            pagination: { type: \"object\", required: [\"total\", \"page\", \"limit\", \"totalPages\"] }",
                  "        }",
                  "    });",
                  "});",
                  "pm.test(\"Respeta el limit pedido\", () => pm.expect(body.products.length).to.be.at.most(5));",
                  "const conStock = body.products.find(p => p.stock >= 5);",
                  "pm.test(\"Existe un producto con stock para el flujo de compra\", () => pm.expect(conStock).to.not.be.undefined);",
                  "pm.collectionVariables.set(\"productId\", conStock.id);",
                  "pm.collectionVariables.set(\"productPrice\", conStock.price);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Guarda un producto con stock para usarlo en el flujo de compra."
          }
        },
        {
          "name": "Tope de 50 por pagina",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El servidor recorta el limit a 50 (RNF-04)\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.pagination.limit).to.eql(50);",
                  "    pm.expect(body.products.length).to.be.at.most(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": ""
