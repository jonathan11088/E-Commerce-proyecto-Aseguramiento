        {
          "name": "Login correcto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve el usuario sin hash ni token en el cuerpo\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get(\"customerEmail\"));",
                  "    pm.expect(body.user).to.not.have.property(\"passwordHash\");",
                  "    pm.expect(body).to.not.have.property(\"token\");",
                  "});",
                  "pm.test(\"Cookie de sesion httpOnly y SameSite Lax (RNF-03)\", () => {",
                  "    const cookie = pm.response.headers.get(\"Set-Cookie\");",
                  "    pm.expect(cookie).to.include(\"authToken=\");",
                  "    pm.expect(cookie).to.include(\"HttpOnly\");",
                  "    pm.expect(cookie).to.include(\"SameSite=Lax\");",
